NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_COUNTDOWN_TARGET=

# ---- Meta Marketing API 연동 (광고 성과 자동 수집) ----
# 시스템 유저 장기 토큰 (ads_read 권한 필요)
META_ACCESS_TOKEN=
# 광고 계정 ID (act_ 접두사 포함, 없으면 자동 보정)
META_AD_ACCOUNT_ID=
# Graph API 버전 (선택, 기본 v23.0)
META_API_VERSION=
# 예산값 통화 최소단위 제수 (선택, KRW=1 / USD 등 2자리=100)
META_CURRENCY_OFFSET=1
# /api/meta/cron · /api/meta/create 보호용 시크릿
CRON_SECRET=

# ---- 광고 생성(쓰기) 전용 — ads_management 권한 필요 ----
# 광고 노출 주체 페이지 ID (creative object_story_spec.page_id)
META_PAGE_ID=
# 선택: Instagram 노출용 actor ID
META_INSTAGRAM_ACTOR_ID=

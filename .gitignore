# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is committed; .env.local is not)
.env*.local
.env.local

# claude code local settings (contains MCP tokens etc.)
.claude/settings.local.json
/playwright-report
/test-results

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ad data (sensitive) — Meta 원본 export. analytics/input 은 데이터만 무시, .gitkeep 유지.
# (구 경로 audit-workspace 는 analytics 로 이름 변경됨)
analytics/input/*
!analytics/input/.gitkeep

# claude code worktrees (런타임 git worktree 내부 디렉터리 — 커밋 대상 아님) & 로컬 bin
.claude/worktrees/
.localbin/

# 원본 사진 (raw)
*.HEIC
*.heic

# 이미지 바이너리는 버전관리하지 않는 컨벤션 (public/courses·public/ads·courses 작업 이미지).
# remotion/public 은 렌더에 필요한 에셋이 추적되므로 제외하지 않는다.
public/courses/
public/ads/
courses/**/*.png
courses/**/*.jpg
courses/**/*.jpeg
courses/**/*.pdf

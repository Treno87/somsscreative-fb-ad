# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is committed; .env.local is not)
.env*.local
.env.local

# claude code local settings (contains MCP tokens etc.)
.claude/settings.local.json
.serena/
/playwright-report
/test-results

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ad data (sensitive) — Meta 원본 export. analytics/input 은 데이터만 무시, .gitkeep 유지.
# (구 경로 audit-workspace 는 analytics 로 이름 변경됨)
analytics/input/*
!analytics/input/.gitkeep
# Meta API 자동 수집 영구 저장소 (cron 런타임 데이터)
analytics/store/

# claude code worktrees (런타임 git worktree 내부 디렉터리 — 커밋 대상 아님) & 로컬 bin
.claude/worktrees/
.localbin/

# 원본 사진 (raw)
*.HEIC
*.heic

# 이미지 바이너리는 버전관리하지 않는 컨벤션 (public/courses·public/ads·courses 작업 이미지).
# remotion/public 은 렌더에 필요한 에셋이 추적되므로 제외하지 않는다.
public/courses/
public/ads/
courses/**/*.png
courses/**/*.jpg
courses/**/*.jpeg
courses/**/*.pdf

# 카메라 원본(raw) — 저장소 안에 두되 커밋하지 않는다. 규약: docs/ad-asset-organization.md
assets/raw/*
!assets/raw/README.md

# 광고 작업 프로젝트(ad-projects/{course}-{기수}-hf).
# 추적/미추적은 확장자가 아니라 역할로 정한다 —
#   추적: 소스(html·sh·json·fonts·images)  /  미추적: 바이너리 결과물·검수 산출물·카메라 원본
# 규약: docs/ad-asset-organization.md
# (주의: .gitignore 는 줄 끝 주석을 지원하지 않는다. 주석은 반드시 별도 줄에.)
# 렌더 스크래치 · 검수 스냅샷 · CLI 캐시
ad-projects/**/renders/
ad-projects/**/snapshots/
ad-projects/**/.thumbnails/
ad-projects/**/.ffbin/
ad-projects/**/_hold/
# 바이너리 결과물. *.MOV 가 없어서 .git 에 348MB 좀비가 생겼었다.
ad-projects/**/*.mp4
ad-projects/**/*.mp3
ad-projects/**/*.MOV
ad-projects/**/*.mov
ad-projects/**/*.MP4
